@model List<PosSoftware.Models.Entities.AppUser>
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark m-0">User & Operator Accounts</h4>
            <span class="text-muted small">Manage cashier and administrative credentials</span>
        </div>
        <a href="@Url.Action("Create", "User")" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i> Add User
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Role</th>
                        <th>Contact</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td><span class="fw-bold text-dark">@u.Username</span></td>
                            <td>@u.FullName</td>
                            <td><span class="badge bg-primary">@(u.Role?.RoleName ?? "Cashier")</span></td>
                            <td>
                                <div>@u.Email</div>
                                <small class="text-muted">@u.Phone</small>
                            </td>
                            <td>
                                <span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">
                                    @(u.IsActive ? "Active" : "Disabled")
                                </span>
                            </td>
                            <td><small class="text-muted">@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("yyyy-MM-dd HH:mm") : "Never")</small></td>
                            <td class="text-center">
                                <a href="@Url.Action("Edit", "User", new { id = u.Id })" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
