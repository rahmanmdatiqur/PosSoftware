@model List<PosSoftware.Models.Entities.Product>
@{
    ViewData["Title"] = "Stock Overview";
    var categories = ViewBag.Categories as List<PosSoftware.Models.Entities.Category> ?? new();
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark m-0">Inventory & Warehouse Stock</h4>
            <span class="text-muted small">Monitor on-hand inventory levels and rapid replenishment</span>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Adjust", "Inventory")" class="btn btn-outline-secondary">
                <i class="bi bi-sliders"></i> Stock Adjustment
            </a>
            <a href="@Url.Action("Transactions", "Inventory")" class="btn btn-outline-primary">
                <i class="bi bi-journal-text"></i> Audit Transactions
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm p-3 mb-3 bg-white rounded-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by name, barcode, SKU..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Categories --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id" selected="@(ViewBag.SelectedCategory == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Stock Statuses --</option>
                    <option value="in" selected="@(ViewBag.SelectedStatus == "in")">In Stock</option>
                    <option value="low" selected="@(ViewBag.SelectedStatus == "low")">Low Stock Alert</option>
                    <option value="out" selected="@(ViewBag.SelectedStatus == "out")">Out of Stock</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel"></i> Filter</button>
            </div>
        </form>
    </div>

    <!-- Inventory Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product Details</th>
                        <th>Barcode</th>
                        <th>Category</th>
                        <th class="text-end">Cost</th>
                        <th class="text-end">Selling</th>
                        <th class="text-center">Current Stock</th>
                        <th class="text-center">Min Alert</th>
                        <th class="text-center">Quick Stock-In</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No matching inventory items found.</td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@p.Name</div>
                                <small class="text-muted">SKU: @p.SKU</small>
                            </td>
                            <td><code>@p.Barcode</code></td>
                            <td>@(p.Category?.Name ?? "-")</td>
                            <td class="text-end text-muted">$@p.CostPrice.ToString("N2")</td>
                            <td class="text-end fw-semibold text-primary">$@p.SellingPrice.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge @(p.CurrentStock <= 0 ? "bg-danger" : p.CurrentStock <= p.MinAlertStock ? "bg-warning text-dark" : "bg-success") fs-6 px-2">
                                    @p.CurrentStock @(p.Unit?.ShortCode ?? "pcs")
                                </span>
                            </td>
                            <td class="text-center text-muted">@p.MinAlertStock</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-success" onclick="openStockInModal(@p.Id, '@p.Name', @p.CurrentStock)">
                                    <i class="bi bi-plus-circle me-1"></i> Stock In
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Quick Stock In Modal -->
<div class="modal fade" id="stockInModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" action="@Url.Action("QuickStockIn", "Inventory")">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-box-arrow-in-down me-1"></i> Quick Stock In</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="productId" id="modalProductId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Product</label>
                        <input type="text" id="modalProductName" class="form-control-plaintext fw-semibold" readonly />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted">Current Stock</label>
                            <input type="text" id="modalCurrentStock" class="form-control" readonly />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-success">Quantity to Add *</label>
                            <input type="number" name="quantity" min="1" class="form-control fw-bold text-success" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">PO / Shipment Reference</label>
                        <input type="text" name="referenceNo" class="form-control" placeholder="PO-2026-001" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted">Notes / Reason</label>
                        <input type="text" name="notes" class="form-control" placeholder="Supplier delivered batch" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold">Confirm Stock Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openStockInModal(id, name, current) {
            document.getElementById('modalProductId').value = id;
            document.getElementById('modalProductName').value = name;
            document.getElementById('modalCurrentStock').value = current;
            var modal = new bootstrap.Modal(document.getElementById('stockInModal'));
            modal.show();
        }
    </script>
}
