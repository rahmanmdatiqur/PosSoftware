@model PosSoftware.Models.ViewModels.RolePermissionMatrixViewModel
@{
    ViewData["Title"] = "Role & Page Permissions";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark m-0">Dynamic RBAC Permission Matrix</h4>
            <span class="text-muted small">Configure View, Create, Edit, and Delete privileges per role and screen</span>
        </div>
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#newRoleModal">
            <i class="bi bi-plus-circle me-1"></i> New System Role
        </button>
    </div>

    <!-- Role Switcher -->
    <div class="card border-0 shadow-sm p-3 mb-3 bg-white rounded-3">
        <div class="row align-items-center">
            <div class="col-md-6 d-flex align-items-center gap-2">
                <span class="fw-bold text-dark">Selected Role:</span>
                <div class="btn-group">
                    @foreach (var r in Model.Roles)
                    {
                        <a href="@Url.Action("Index", "RolePermission", new { roleId = r.Id })" 
                           class="btn btn-sm @(Model.RoleId == r.Id ? "btn-primary" : "btn-outline-secondary")">
                            @r.RoleName
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-6 text-md-end mt-2 mt-md-0">
                <button type="button" class="btn btn-sm btn-light border" onclick="toggleAllCheckboxes(true)">Check All</button>
                <button type="button" class="btn btn-sm btn-light border" onclick="toggleAllCheckboxes(false)">Uncheck All</button>
            </div>
        </div>
    </div>

    <!-- Matrix Form -->
    <form method="post" action="@Url.Action("SavePermissions", "RolePermission")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="roleId" value="@Model.RoleId" />

        <div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Module / Screen</th>
                            <th class="text-center" style="width: 120px;">
                                View
                                <input type="checkbox" class="form-check-input ms-1" onchange="toggleColumn('view-cb', this.checked)" />
                            </th>
                            <th class="text-center" style="width: 120px;">
                                Create
                                <input type="checkbox" class="form-check-input ms-1" onchange="toggleColumn('create-cb', this.checked)" />
                            </th>
                            <th class="text-center" style="width: 120px;">
                                Edit
                                <input type="checkbox" class="form-check-input ms-1" onchange="toggleColumn('edit-cb', this.checked)" />
                            </th>
                            <th class="text-center" style="width: 120px;">
                                Delete
                                <input type="checkbox" class="form-check-input ms-1" onchange="toggleColumn('delete-cb', this.checked)" />
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Rows.Count; i++)
                        {
                            var row = Model.Rows[i];
                            <tr class="perm-row">
                                <td>
                                    <input type="hidden" name="permissions[@i].ModulePageId" value="@row.AppModulePageId" />
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="@row.IconClass text-primary fs-5"></i>
                                        <div>
                                            <div class="fw-bold text-dark">@row.DisplayName</div>
                                            <small class="text-muted">Module: @row.ModuleName &bull; Code: @row.PageName</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" name="permissions[@i].CanView" value="true" class="form-check-input perm-cb view-cb" @(row.CanView ? "checked" : "") />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" name="permissions[@i].CanCreate" value="true" class="form-check-input perm-cb create-cb" @(row.CanCreate ? "checked" : "") />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" name="permissions[@i].CanEdit" value="true" class="form-check-input perm-cb edit-cb" @(row.CanEdit ? "checked" : "") />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" name="permissions[@i].CanDelete" value="true" class="form-check-input perm-cb delete-cb" @(row.CanDelete ? "checked" : "") />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-light p-3 text-end">
                <button type="submit" class="btn btn-primary px-4 fw-bold">
                    <i class="bi bi-save me-1"></i> Save Changes to @Model.RoleName
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Modal Create Role -->
<div class="modal fade" id="newRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" action="@Url.Action("CreateRole", "RolePermission")">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Create New Role</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Role Name *</label>
                        <input type="text" name="RoleName" class="form-control" placeholder="e.g. StoreSupervisor" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <input type="text" name="Description" class="form-control" placeholder="Role responsibilities..." />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold">Create Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleAllCheckboxes(state) {
            document.querySelectorAll('.perm-cb').forEach(cb => cb.checked = state);
        }
        function toggleColumn(className, state) {
            document.querySelectorAll('.' + className).forEach(cb => cb.checked = state);
        }
    </script>
}
