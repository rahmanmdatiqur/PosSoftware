@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <h1 class="text-danger display-4"><i class="bi bi-exclamation-triangle"></i> Error</h1>
    <h2 class="text-secondary">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a href="/" class="btn btn-primary mt-3"><i class="bi bi-house"></i> Return to Dashboard</a>
</div>
