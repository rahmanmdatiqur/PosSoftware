@model PosSoftware.Models.Entities.Product
@{
    ViewData["Title"] = "Edit Product";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark m-0">Edit Product: @Model.Name</h4>
            <span class="text-muted small">Update brand/specification, image, SKU, barcode, and rates</span>
        </div>
        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>

    <div class="card border-0 shadow-sm p-4 bg-white rounded-3 col-lg-10 mx-auto">
        <form method="post" action="@Url.Action("Edit", "Product", new { id = Model.Id })" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CurrentStock" />
            <input type="hidden" asp-for="ImageUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger small border-0 mb-3"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Product Name *</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Brand / Specification</label>
                    <input asp-for="GenericName" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Barcode *</label>
                    <input asp-for="Barcode" class="form-control" required />
                    <span asp-validation-for="Barcode" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">SKU Code *</label>
                    <input asp-for="SKU" class="form-control" required />
                    <span asp-validation-for="SKU" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Category *</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" required></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Unit of Measure *</label>
                    <select asp-for="UnitId" asp-items="ViewBag.Units" class="form-select" required></select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Supplier</label>
                    <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                        <option value="">-- No Supplier --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Cost Price (৳) *</label>
                    <input asp-for="CostPrice" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Selling Price (৳) *</label>
                    <input asp-for="SellingPrice" type="number" step="0.01" class="form-control fw-bold text-primary" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">MRP (৳)</label>
                    <input asp-for="MRP" type="number" step="0.01" class="form-control fw-semibold text-success" />
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Current Stock (Qty)</label>
                    <input type="text" class="form-control bg-light" value="@Model.CurrentStock" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Min Alert Stock Threshold</label>
                    <input asp-for="MinAlertStock" type="number" class="form-control" />
                </div>
                <!-- Image Upload & Current Image Preview -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Change Product Image</label>
                    <input type="file" name="imageFile" id="imageFileInput" class="form-control" accept="image/*" onchange="previewImage(this)" />
                    <div class="mt-2 d-flex align-items-center gap-2">
                        <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/uploads/products/pharma-item.svg" : Model.ImageUrl)" alt="Current Image" class="border rounded p-1" style="width: 55px; height: 55px; object-fit: contain; background:#f8fafc;" />
                        <span class="text-muted small">Choose new file to update</span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label fw-semibold">Active Product</label>
            </div>

            <button type="submit" class="btn btn-theme-save px-4 fw-bold">
                <i class="bi bi-save me-1"></i> Update Product
            </button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imagePreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
}
