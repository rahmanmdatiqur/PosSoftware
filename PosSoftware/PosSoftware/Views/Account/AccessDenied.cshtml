@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="d-inline-flex p-4 bg-danger bg-opacity-10 text-danger rounded-circle mb-3">
        <i class="bi bi-shield-x display-3"></i>
    </div>
    <h2 class="fw-bold text-dark">Access Denied</h2>
    <p class="text-muted col-md-6 mx-auto">
        Your role does not have permission to perform <b>@ViewBag.ActionType</b> on <b>@ViewBag.PageName</b>.
    </p>

    <div class="d-flex justify-content-center gap-2 mt-4">
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Go Back
        </a>
        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
    </div>
</div>
