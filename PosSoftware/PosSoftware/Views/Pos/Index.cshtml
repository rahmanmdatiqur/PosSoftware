@model PosSoftware.Models.ViewModels.PosTerminalViewModel
@{
    ViewData["Title"] = "POS Terminal";
}

<div class="pos-container">
    <!-- Left Pane: Product Catalog matching Screenshot 1 -->
    <div class="pos-catalog-pane d-flex flex-column">
        <!-- Top Controls Bar matching Screenshot 1 -->
        <div class="card border-0 shadow-sm p-2 mb-2 bg-white rounded-3">
            <!-- Row 1: Code, Editing badge, + New, Invoice link, Date -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-2 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-1">
                    <span class="text-uppercase text-secondary fw-bold small" style="font-size: 0.72rem; letter-spacing: 0.5px;">Code</span>
                    <span class="font-monospace fw-bold text-dark fs-6" id="posCurrentInvoiceCode">@Model.DefaultInvoiceNumber</span>
                    <span class="badge bg-warning text-dark px-2 py-1 small fw-bold" style="font-size: 0.68rem;">EDITING</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-0 fw-semibold" onclick="resetPosForNextOrder()" title="Start New Order">
                        <i class="bi bi-plus-lg"></i> New
                    </button>
                    <a href="@Url.Action("Index", "Sales")" class="btn btn-sm btn-outline-primary px-2 py-0 fw-semibold">
                        <i class="bi bi-receipt"></i> Invoice / Sales List
                    </a>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-uppercase text-secondary fw-bold small" style="font-size: 0.72rem; letter-spacing: 0.5px;">Date</span>
                    <input type="date" id="posOrderDate" class="form-control form-control-sm text-center p-1" value="@DateTime.Now.ToString("yyyy-MM-dd")" style="width: 130px; font-size: 0.8rem;" />
                </div>
            </div>

            <!-- Row 2: Search Input, Columns Dropdown, Categories Dropdown matching Screenshot 1 -->
            <div class="row g-1 align-items-center">
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted border-end-0 py-1">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="posSearchInput" class="form-control bg-light border-start-0 py-1" 
                               placeholder="Search product..." autocomplete="off" style="font-size: 0.82rem;" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted py-1" style="font-size: 0.72rem;">COLUMNS</span>
                        <select id="posColumnsSelect" class="form-select form-select-sm py-1" onchange="changeGridColumns(this.value)" style="font-size: 0.8rem;">
                            <option value="row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-4 row-cols-xxl-5" selected>4</option>
                            <option value="row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xl-5 row-cols-xxl-6">5</option>
                            <option value="row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-xl-3">3</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted py-1" style="font-size: 0.72rem;">CATEGORIES</span>
                        <select id="posCategorySelect" class="form-select form-select-sm py-1" onchange="onCategorySelectChange(this.value)" style="font-size: 0.8rem;">
                            <option value="0">All Categories</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Cards Grid: overflow-x hidden, g-2 gutter prevents horizontal scrollbar -->
        <div class="flex-grow-1 pe-1" id="posCatalogScroll" style="overflow-y: auto; overflow-x: hidden;">
            <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-4 row-cols-xxl-5 g-2" id="posProductGrid">
                @foreach (var prod in Model.Products)
                {
                    <div class="col pos-product-item" 
                         id="posProductCol_@prod.Id"
                         data-id="@prod.Id" 
                         data-name="@prod.Name" 
                         data-barcode="@prod.Barcode" 
                         data-sku="@prod.SKU" 
                         data-category-id="@prod.CategoryId">
                        <div class="product-card-v2 shadow-sm position-relative h-100" 
                             id="posProductCard_@prod.Id"
                             onclick='addToCart(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                                 id = prod.Id,
                                 name = prod.Name,
                                 barcode = prod.Barcode,
                                 sku = prod.SKU,
                                 sellingPrice = prod.SellingPrice,
                                 costPrice = prod.CostPrice,
                                 currentStock = prod.CurrentStock,
                                 unitName = prod.Unit?.ShortCode ?? "pcs"
                             })))'>
                            <!-- Image Container with soft bg & plus button in bottom-right corner -->
                            <div class="product-img-box position-relative">
                                <img src="@(string.IsNullOrEmpty(prod.ImageUrl) ? "/uploads/products/pharma-item.svg" : prod.ImageUrl)" 
                                     alt="@prod.Name" class="product-img" />
                                <span class="btn-card-plus position-absolute">
                                    <i class="bi bi-plus"></i>
                                </span>
                                <!-- Live Selected Badge -->
                                <span id="cardSelectedBadge_@prod.Id" class="card-selected-badge position-absolute top-0 end-0 badge bg-primary d-none m-1 shadow-sm">
                                    <span id="cardSelectedQty_@prod.Id">0</span>
                                </span>
                            </div>

                            <!-- Under Image: Price on top line, Product Name on bottom line -->
                            <div class="product-info-box mt-1 text-start">
                                <div class="fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.2;">
                                    ৳ @prod.SellingPrice.ToString("N2")
                                </div>
                                <div class="text-secondary text-truncate small mt-0" title="@prod.Name" style="font-size: 0.74rem;">
                                    @prod.Name
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1 text-muted" style="font-size: 0.68rem;">
                                    <span>@prod.SKU</span>
                                    <span class="badge @(prod.CurrentStock <= prod.MinAlertStock ? "bg-danger" : "bg-success") py-0 px-1">
                                        @prod.CurrentStock @(prod.Unit?.ShortCode ?? "pcs")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Pagination Bar matching Screenshot 1 -->
        <div class="p-2 bg-white rounded-3 mt-1 border-0 shadow-sm d-flex align-items-center justify-content-between small text-muted">
            <div class="d-flex align-items-center gap-1">
                <span class="fw-semibold" style="font-size: 0.75rem;">SHOW</span>
                <select id="posPageSizeSelect" class="form-select form-select-sm py-0 px-1" style="width: 65px; font-size: 0.78rem;" onchange="changePageSize(this.value)">
                    <option value="20" selected>20</option>
                    <option value="40">40</option>
                    <option value="80">80</option>
                    <option value="170">All</option>
                </select>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-0" id="btnPrevPage" onclick="prevCatalogPage()" style="font-size: 0.78rem;">&lt; Prev</button>
                <span id="posPaginationInfo" style="font-size: 0.78rem;">1-20 of @Model.Products.Count</span>
                <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-0" id="btnNextPage" onclick="nextCatalogPage()" style="font-size: 0.78rem;">Next &gt;</button>
            </div>
        </div>
    </div>

    <!-- Right Pane: Order Cart & Checkout (Responsive, Scrollable, Always-Visible Save Button) -->
    <div class="pos-cart-pane shadow-sm">
        <!-- Header: Customer Selector + Counter -->
        <div class="p-2 border-bottom bg-white flex-shrink-0">
            <div class="row g-1">
                <div class="col-7">
                    <label class="form-label small text-muted text-uppercase mb-0" style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.5px;">Customer</label>
                    <div class="input-group input-group-sm">
                        <select id="posCustomerSelect" class="form-select py-1" style="font-size: 0.78rem;">
                            @foreach (var cust in Model.Customers)
                            {
                                <option value="@cust.Id">@cust.Name (@cust.Phone)</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-secondary px-2 py-1" onclick="openAddCustomerQuickModal()" title="Add Customer">
                            <i class="bi bi-person-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="col-5">
                    <label class="form-label small text-muted text-uppercase mb-0" style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.5px;">Counter</label>
                    <select class="form-select form-select-sm py-1" id="posCounterSelect" style="font-size: 0.78rem;">
                        <option value="Counter 1">Counter 1</option>
                        <option value="Main Counter">Main Counter</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Cart Items List: Scrollable container -->
        <div class="p-2 border-bottom bg-white" id="cartItemsContainer" style="max-height: 150px; min-height: 70px; overflow-y: auto;">
            <div id="cartEmptyPlaceholder" class="text-center text-muted py-3 small">
                <i class="bi bi-cart-x fs-2 d-block mb-1 text-secondary"></i>
                Select products from the catalog to build invoice.
            </div>
            <div id="cartItemsList" class="d-none">
                <!-- Dynamically generated rows -->
            </div>
        </div>

        <!-- Calculations Summary & Checkout: Compact Grid matching Screenshot 1 -->
        <div class="p-2 bg-light flex-grow-1" style="font-size: 0.82rem;">
            <!-- 2-Column Summary Grid to Save Vertical Space -->
            <div class="row g-1 small mb-1">
                <div class="col-6 d-flex justify-content-between align-items-center">
                    <span class="text-muted">Sub Total:</span>
                    <span class="fw-semibold text-dark" id="lblSubtotal">0.00</span>
                </div>
                <div class="col-6 d-flex justify-content-between align-items-center">
                    <span class="text-muted">VAT / SD:</span>
                    <span class="text-dark"><span id="lblTax">0.00</span> / <span id="lblSd">0.00</span></span>
                </div>
                <div class="col-6 d-flex justify-content-between align-items-center">
                    <span class="text-muted">Discount:</span>
                    <input type="number" step="any" min="0" id="discountAmountInput" class="form-control form-control-sm text-end p-0 px-1" style="width: 70px; height: 22px; font-size: 0.78rem;" value="0.00" oninput="onDiscountAmountInput(this.value)" />
                </div>
                <div class="col-6 d-flex justify-content-between align-items-center">
                    <span class="text-muted">Change:</span>
                    <span class="fw-bold text-danger" id="lblChangeDue">0.00</span>
                </div>
            </div>

            <!-- Grand Total Bar -->
            <div class="d-flex justify-content-between align-items-center py-1 px-2 mb-1 bg-white border rounded shadow-xs">
                <span class="fw-bold text-dark small">Grand Total:</span>
                <span class="fw-extrabold text-primary fs-6" id="lblGrandTotal">৳ 0.00</span>
            </div>
            <div class="d-flex justify-content-between small text-muted mb-1 px-1" style="font-size: 0.75rem;">
                <span>Total Paid: <strong class="text-dark" id="lblPaid">0.00</strong></span>
                <span>Remaining: <strong class="text-success" id="lblRemaining">0.00</strong></span>
            </div>

            <!-- Payments Section matching Screenshot 1 -->
            <div class="border-top pt-1 mb-1">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-uppercase small fw-bold text-secondary" style="font-size: 0.68rem; letter-spacing: 0.5px;">Payments</span>
                    <a href="javascript:void(0)" class="small text-primary text-decoration-none fw-semibold" style="font-size: 0.72rem;" onclick="fillRemainingPayment()">Fill remaining</a>
                </div>
                <div class="input-group input-group-sm mb-1">
                    <select id="paymentTypeSelect" class="form-select py-0 px-1" style="max-width: 85px; font-size: 0.78rem; height: 26px;">
                        <option value="Cash" selected>CASH</option>
                        <option value="Card">CARD</option>
                        <option value="MobileBanking">MOBILE</option>
                    </select>
                    <input type="number" step="any" id="paymentAmountInput" class="form-control text-end py-0 px-1" placeholder="Amount" style="font-size: 0.78rem; height: 26px;" />
                    <button type="button" class="btn btn-success px-2 py-0 fw-bold" onclick="addPaymentRow()" style="font-size: 0.78rem; height: 26px;">Add</button>
                </div>
                <div id="addedPaymentsList" class="mb-1">
                    <!-- Added payment rows -->
                </div>
            </div>

            <!-- Reference / Remarks matching Screenshot 1 -->
            <div class="row g-1 mb-2">
                <div class="col-5">
                    <input type="text" id="posReferenceInput" class="form-control form-control-sm p-1" placeholder="Ref (NA)" value="NA" style="font-size: 0.75rem; height: 26px;" />
                </div>
                <div class="col-7">
                    <input type="text" id="posRemarksInput" class="form-control form-control-sm p-1" placeholder="Remarks" style="font-size: 0.75rem; height: 26px;" />
                </div>
            </div>

            <!-- Action Buttons: 100% PROMINENT & VISIBLE -->
            <!-- Button 1: Save Sale (Big bold button) -->
            <button type="button" class="btn btn-success w-100 py-2 fw-bold text-white mb-1 shadow-sm d-flex align-items-center justify-content-center gap-1" onclick="saveSaleOrder(false, false)" style="font-size: 0.95rem;">
                <i class="bi bi-check-circle-fill fs-5"></i> Save Sale
            </button>

            <!-- Row 2: Post, Post & POS Print, POS Print -->
            <div class="d-flex gap-1 mb-1">
                <button type="button" class="btn btn-sm btn-light border flex-grow-1 p-1 small" onclick="saveSaleOrder(true, false)" title="Post Sale" style="font-size: 0.75rem;">
                    <i class="bi bi-printer me-1"></i> Post
                </button>
                <button type="button" class="btn btn-sm btn-light border flex-grow-1 p-1 small" onclick="saveSaleOrder(true, true)" title="Post & Print POS" style="font-size: 0.75rem;">
                    <i class="bi bi-printer me-1"></i> Post &amp; Print
                </button>
                <button type="button" class="btn btn-sm btn-success flex-grow-1 p-1 small fw-bold" onclick="saveSaleOrder(false, true)" title="POS Print" style="font-size: 0.75rem;">
                    <i class="bi bi-printer-fill me-1"></i> POS Print
                </button>
            </div>

            <!-- Row 3: Park, Drafts, Clear -->
            <div class="d-flex gap-1 mb-1">
                <button type="button" class="btn btn-sm btn-warning text-dark flex-grow-1 p-1 small fw-semibold" onclick="parkCurrentOrder()" style="font-size: 0.75rem;">
                    <i class="bi bi-pause-fill"></i> Park
                </button>
                <button type="button" class="btn btn-sm btn-primary flex-grow-1 p-1 small fw-semibold" onclick="openDraftsModal()" style="font-size: 0.75rem;">
                    <i class="bi bi-folder2-open"></i> Drafts (<span id="draftsCount">0</span>)
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger flex-grow-1 p-1 small fw-semibold" onclick="clearCart()" style="font-size: 0.75rem;">
                    <i class="bi bi-x-lg"></i> Clear
                </button>
            </div>

            <div class="text-center text-muted" id="posLastSaleStatus" style="font-size: 0.72rem;">
                Last sale: None
            </div>
        </div>
    </div>
</div>

<!-- Floating Notification Bar at bottom-right matching Screenshot 1 -->
<div id="posSavedBottomToast" class="position-fixed bottom-0 end-0 m-3 p-2 bg-success text-white rounded-3 shadow-lg d-none align-items-center gap-2" style="z-index: 1060;">
    <span><i class="bi bi-check-circle-fill me-1"></i> Saved <strong id="toastInvoiceNo"></strong> (posted)</span>
    <a href="@Url.Action("Index", "Sales")" class="btn btn-sm btn-light py-0 px-2 fw-bold text-success">
        View Sales Table
    </a>
    <button type="button" class="btn btn-sm btn-outline-light py-0 px-2" onclick="printPosInvoice()">POS Print</button>
    <button type="button" class="btn-close btn-close-white btn-sm" onclick="hideSavedToast()"></button>
</div>

<!-- Quick Add Customer Modal -->
<div class="modal fade" id="quickAddCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header py-2 bg-light">
                <h6 class="modal-title fw-bold"><i class="bi bi-person-plus me-1 text-primary"></i> Add Customer</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small text-muted mb-1">Name *</label>
                    <input type="text" id="quickCustName" class="form-control form-control-sm" placeholder="Customer name" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted mb-1">Phone</label>
                    <input type="text" id="quickCustPhone" class="form-control form-control-sm" placeholder="Mobile number" />
                </div>
                <div>
                    <label class="form-label small text-muted mb-1">Address</label>
                    <input type="text" id="quickCustAddress" class="form-control form-control-sm" placeholder="Address" />
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary fw-bold" onclick="submitQuickCustomer()">Save &amp; Select</button>
            </div>
        </div>
    </div>
</div>

<!-- Drafts / Parked Orders Modal matching Screenshot 1 -->
<div class="modal fade" id="draftsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header py-2 bg-light">
                <h6 class="modal-title fw-bold"><i class="bi bi-folder2-open me-1 text-primary"></i> Parked Orders (Drafts)</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive" style="max-height: 320px;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Time</th>
                                <th>Items</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center" style="width: 120px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="draftsTableBody">
                            <tr><td colspan="5" class="text-center text-muted py-4">No parked orders.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- In-page Official Sales Invoice Report Modal -->
<div class="modal fade" id="posInvoiceModal" tabindex="-1" aria-labelledby="posInvoiceModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-dark text-white py-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success fs-6"><i class="bi bi-check2-circle"></i> Sale Saved &amp; Posted</span>
                    <h5 class="modal-title fs-6 mb-0" id="posInvoiceModalLabel">
                        Invoice: <span id="modalInvoiceNo" class="text-warning fw-bold"></span>
                    </h5>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="@Url.Action("Index", "Sales")" class="btn btn-sm btn-light fw-bold text-dark">
                        <i class="bi bi-table me-1"></i> View in Sales Table
                    </a>
                    <button type="button" class="btn btn-sm btn-primary fw-bold" onclick="printPosInvoice()">
                        <i class="bi bi-printer-fill me-1"></i> Print Invoice
                    </button>
                    <button type="button" class="btn btn-sm btn-success fw-bold" onclick="resetPosForNextOrder()" data-bs-dismiss="modal">
                        <i class="bi bi-plus-circle me-1"></i> New Sale
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="resetPosForNextOrder()"></button>
                </div>
            </div>
            <div class="modal-body p-0 bg-light" style="min-height: 550px; height: 75vh;">
                <iframe id="posInvoiceFrame" style="width: 100%; height: 100%; border: none;" src="about:blank"></iframe>
            </div>
            <div class="modal-footer py-2 px-3 bg-white d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i> Invoice report rendered directly from Sales database.
                </span>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Index", "Sales")" class="btn btn-outline-primary btn-sm fw-bold">
                        <i class="bi bi-list-check me-1"></i> Go to Sales Index
                    </a>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetPosForNextOrder()" data-bs-dismiss="modal">
                        Close &amp; Next Order
                    </button>
                    <button type="button" class="btn btn-primary btn-sm px-3 fw-bold" onclick="printPosInvoice()">
                        <i class="bi bi-printer me-1"></i> Print
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pos.js" asp-append-version="true"></script>
}
